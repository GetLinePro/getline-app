<?xml version="1.0" encoding="utf-8"?>
<!--
  Split item: the whole left area selects the country, the trailing chevron is a
  separate 48dp target that only expands. Selecting reconnects the VPN, so the
  two actions must not share one hit box.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/group_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/getline_brand_surface"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/getline_hairline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:minHeight="60dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/group_select"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="60dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/group_label"
                    style="@style/Widget.GetLine.Text.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/getline_text_primary"
                    tools:text="🇩🇪 Германия" />

                <TextView
                    android:id="@+id/group_variant"
                    style="@style/Widget.GetLine.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/getline_text_secondary"
                    android:visibility="gone"
                    tools:text="xhttp"
                    tools:visibility="visible" />
            </LinearLayout>

            <TextView
                android:id="@+id/group_delay"
                style="@style/Widget.GetLine.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/getline_text_secondary"
                android:visibility="gone"
                tools:text="60 мс"
                tools:visibility="visible" />
        </LinearLayout>

        <View
            android:id="@+id/group_divider"
            android:layout_width="1dp"
            android:layout_height="32dp"
            android:layout_gravity="center_vertical"
            android:background="@color/getline_hairline"
            android:visibility="gone"
            tools:visibility="visible" />

        <FrameLayout
            android:id="@+id/group_expand"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:minHeight="60dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/group_chevron"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_getline_chevron_down"
                app:tint="@color/getline_text_secondary" />
        </FrameLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
