<?xml version="1.0" encoding="utf-8"?>
<!--
  Opaque edge-to-edge dock. No corner radius, no side/bottom inset: this is
  chrome that meets the screen edges, not a floating card. The hairline top
  layer replaces elevation/shadow as the only separation from content.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/getline_shell_bar_background" />
        </shape>
    </item>
    <item
        android:height="1dp"
        android:gravity="top">
        <shape android:shape="rectangle">
            <solid android:color="@color/getline_hairline_subtle" />
        </shape>
    </item>
</layer-list>
