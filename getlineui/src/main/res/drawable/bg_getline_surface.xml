<?xml version="1.0" encoding="utf-8"?>
<!--
  Static brand surface: opaque base + two soft corner washes.
  Replaces the animated particle backdrop (brand owner rejected the moving orbs).

  Light sources sit exactly on the corners (centerX/centerY 0 or 1) so only a
  quarter of each circle is visible — reads as off-frame light, not as a shape.
  Nothing animates and nothing invalidates: drawn once per layout pass.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/getline_brand_background" />
        </shape>
    </item>

    <!-- Cyan wash, top-start corner. Alpha fades to fully transparent same-hue
         so the falloff never turns grey. -->
    <item>
        <shape
            android:dither="true"
            android:shape="rectangle">
            <gradient
                android:centerX="0.0"
                android:centerY="0.0"
                android:endColor="#0021DCFF"
                android:gradientRadius="@dimen/get_line_surface_wash_radius_top"
                android:startColor="#2021DCFF"
                android:type="radial" />
        </shape>
    </item>

    <!-- Green wash, bottom-end. Pulled off the very corner so it stays visible
         above the opaque shell dock on Home. -->
    <item>
        <shape
            android:dither="true"
            android:shape="rectangle">
            <gradient
                android:centerX="1.0"
                android:centerY="0.85"
                android:endColor="#0000F996"
                android:gradientRadius="@dimen/get_line_surface_wash_radius_bottom"
                android:startColor="#1A00F996"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
