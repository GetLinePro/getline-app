<?xml version="1.0" encoding="utf-8"?>
<!--
  Status chip behind subscription state. Solid white so backgroundTint can set
  the semantic fill; the label itself still names the state, so colour is never
  the only carrier.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="100dp" />
    <solid android:color="#FFFFFFFF" />
</shape>
