<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Product dark theme for :getlineui. Named GetLineTheme (not AppThemeDark) so
      it does not merge-collide with :design while app depends on both modules.
    -->
    <style name="GetLineThemeBase" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">@color/color_dark_background</item>
        <item name="android:colorBackground">@color/color_dark_background</item>
        <item name="android:ambientShadowAlpha">0.08</item>
        <item name="android:spotShadowAlpha">0.08</item>

        <item name="colorPrimary">@color/color_clash_dark</item>
        <item name="colorOnPrimary">@color/getline_brand_on_primary</item>
        <item name="colorSurface">@color/color_dark_surface</item>
        <item name="colorOnSurface">@color/getline_text_primary</item>
        <item name="colorControlNormal">@color/getline_text_primary</item>
        <item name="colorControlDisabled">@color/getline_text_disabled</item>

        <item name="colorPrimaryDark">?attr/colorPrimary</item>
        <item name="colorSecondary">?attr/colorPrimary</item>
        <item name="colorOnSecondary">?attr/colorOnPrimary</item>
        <item name="colorControlActivated">?attr/colorPrimary</item>
        <item name="android:textColor">@color/getline_text_primary</item>
        <item name="android:textColorPrimary">@color/getline_text_primary</item>
        <item name="android:textColorSecondary">@color/getline_text_secondary</item>
        <item name="android:textColorHint">@color/getline_text_disabled</item>
        <item name="android:textColorPrimaryDisableOnly">@color/getline_text_disabled</item>
        <item name="android:fontFamily">@font/mulish</item>
        <item name="fontFamily">@font/mulish</item>
        <item name="textAppearanceHeadline6">@style/TextAppearance.GetLine.Headline6</item>
        <item name="textAppearanceSubtitle1">@style/TextAppearance.GetLine.Subtitle1</item>
        <item name="textAppearanceBody1">@style/TextAppearance.GetLine.Body1</item>
        <item name="textAppearanceBody2">@style/TextAppearance.GetLine.Body2</item>
        <item name="textAppearanceCaption">@style/TextAppearance.GetLine.Caption</item>
        <item name="textAppearanceButton">@style/TextAppearance.GetLine.Button</item>
    </style>

    <style name="GetLineTheme" parent="GetLineThemeBase">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
