<?xml version="1.0" encoding="utf-8"?>
<!-- Variant inside an expanded country group. Indented, no card of its own. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/variant_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingStart="28dp"
    android:paddingEnd="14dp">

    <ImageView
        android:id="@+id/variant_check"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_outline_check_circle"
        app:tint="@color/getline_accent"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/variant_label"
        style="@style/Widget.GetLine.Text.Primary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/getline_text_secondary"
        tools:text="xhttp" />

    <TextView
        android:id="@+id/variant_delay"
        style="@style/Widget.GetLine.Text.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/getline_text_secondary"
        android:visibility="gone"
        tools:text="61 мс"
        tools:visibility="visible" />
</LinearLayout>
