<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/getline_share_dialog_surface"
    app:cardCornerRadius="@dimen/get_line_share_dialog_corner"
    app:cardElevation="0dp"
    app:strokeColor="@color/getline_hairline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/get_line_share_dialog_padding">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/get_line_share_subscription"
            android:textAlignment="viewStart"
            style="@style/Widget.GetLine.Text.Headline" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/get_line_share_qr_container"
            android:layout_width="@dimen/get_line_share_qr_size"
            android:layout_height="@dimen/get_line_share_qr_size"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/get_line_share_dialog_content_gap"
            app:cardBackgroundColor="@color/getline_brand_background"
            app:cardCornerRadius="@dimen/get_line_share_qr_corner"
            app:cardElevation="0dp"
            app:strokeColor="@color/getline_hairline"
            app:strokeWidth="1dp">

            <ImageView
                android:id="@+id/get_line_share_qr"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:contentDescription="@string/get_line_share_subscription_qr"
                android:importantForAccessibility="yes"
                android:padding="@dimen/get_line_share_qr_padding"
                android:scaleType="fitCenter" />

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/get_line_share_dialog_actions_gap"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/get_line_share_cancel"
                style="@style/Widget.GetLine.ShareDialog.SecondaryButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cancel" />

            <Space
                android:layout_width="@dimen/get_line_share_dialog_button_gap"
                android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/get_line_share_copy"
                style="@style/Widget.GetLine.ShareDialog.PrimaryButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.25"
                android:text="@string/get_line_share_subscription_copy" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
