.gradle
build/
/app/foss/release
/app/premium/release
/captures

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar targetFile (.jar files are usually ignored)
!gradle-wrapper.jar

# Cache of project
.gradletasknamecache

# # Work around https://youtrack.jetbrains.com/issue/IDEA-116898
# gradle/wrapper/gradle-wrapper.properties

# Ignore IDEA config
*.iml
/.idea/*
!/.idea/codeStyles
/core/src/main/golang/.idea/*
!/core/src/main/golang/.idea/codeStyles
/core/src/foss/golang/.idea/*
!/core/src/foss/golang/.idea/codeStyles
/core/src/premium/golang/.idea/*
!/core/src/premium/golang/.idea/codeStyles

# Geodata is a pinned, checksummed release input. Do not ignore it.

# KeyStore. Patterns are prefix/suffix-tolerant on purpose: plain
# `*.keystore` did not cover `release.keystore.bak-2026-07-30`, and
# `signing.properties` did not cover an editor swap file next to it.
signing.properties*
.signing.properties*
.act.secrets
.act.vars
*.keystore
*.keystore.*
*.jks
*.jks.*
*.p12
*.pepk
*.swp
/getline-signing-backup-*

# clion cmake build
cmake-build-*

# local.properties
local.properties


# tracker
tracker.properties

# vscode
.vscode

# cxx
.cxx

*.hprof

# firebase
google-services.json

# Dolphin
.directory

# logs
*.log

# MacOS
.DS_Store

# Security scan working reports (baselines under security/baselines/ are committed)
/security/reports/

# Internal working notes: incident journals, priorities, vendor recon.
# Only distilled contracts belong in docs/.
/docs/internal/

# Local agent instructions. Kept out of the repo on purpose: working methods are
# the author's own, not a project artifact. Agents read it from the checkout.
# Both names point at one file outside the repo, so the tools cannot drift apart.
/AGENTS.md
/CLAUDE.md

# Local inputs for GitHub Actions runs via `act`; may contain secrets.
/.act.secrets
/.act.vars
