<?xml version="1.0" encoding="utf-8"?>
<!--
  GL-22 / #76: Advanced (legacy CMFA UI) is debug-only.
  Drop entry points from every release build type (alpha/prod, any flavor).
  Sources stay in the tree so upstream merge stays clean; activities without a
  manifest entry cannot be started (ActivityNotFoundException).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <activity
            android:name=".ProfilesActivity"
            tools:node="remove" />
        <activity
            android:name=".NewProfileActivity"
            tools:node="remove" />
        <activity
            android:name=".PropertiesActivity"
            tools:node="remove" />
        <activity
            android:name=".ProxyActivity"
            tools:node="remove" />
        <activity
            android:name=".ProvidersActivity"
            tools:node="remove" />
        <activity
            android:name=".LogsActivity"
            tools:node="remove" />
        <activity
            android:name=".LogcatActivity"
            tools:node="remove" />
        <!-- GL-12 / #39 PR 1: debug-only LogcatService stays in main; drop it from release. -->
        <service
            android:name=".LogcatService"
            tools:node="remove" />
        <activity
            android:name=".SettingsActivity"
            tools:node="remove" />
        <activity
            android:name=".NetworkSettingsActivity"
            tools:node="remove" />
        <activity
            android:name=".AppSettingsActivity"
            tools:node="remove" />
        <activity
            android:name=".OverrideSettingsActivity"
            tools:node="remove" />
        <activity
            android:name=".MetaFeatureSettingsActivity"
            tools:node="remove" />
        <!--
          .AccessControlActivity is deliberately NOT stripped since issue #21:
          split tunnelling is a product feature and Home links to it directly, the
          same way HelpActivity is kept. Everything that used to reach it
          (SettingsActivity → NetworkSettingsActivity) stays removed, so the
          legacy tree is still debug-only.

          Do not re-add it to this list to "finish GL-22" — that turns the Home
          row into ActivityNotFoundException in release builds only.
        -->
        <activity
            android:name=".FilesActivity"
            tools:node="remove" />
    </application>
</manifest>
