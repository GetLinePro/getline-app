<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing about a VPN install leaves the device. Reinstall starts from scratch:
    sign in again, profile is provisioned again.

    Two reasons, either one sufficient:
    - A subscription profile names the servers this user connects to. Where the app
      is used, that is not something to hand to a cloud backup.
    - Profiles survived a reinstall while the session (Keystore-backed, never backed
      up) did not, so the launcher opened Home for a user who was not signed in.

    android:allowBackup="false" covers cloud backup on every version. It does NOT
    cover device-to-device transfer on Android 12+, hence the rules below. An empty
    block would mean "transfer everything" — the default set applies whenever no
    rule says otherwise — so every domain is excluded by name.
-->
<data-extraction-rules>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
